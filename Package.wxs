<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Photo Duplicate Checker"
           Manufacturer="Photo Duplicate Checker"
           Version="$(Version)"
           UpgradeCode="7b0f7c3e-5a1d-4c52-9e0a-3d2b8f6a41c9"
           Scope="perMachine">

    <Icon Id="AppIcon.ico" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Photo Duplicate Checker is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Photo Duplicate Checker" />
    </StandardDirectory>

    <!-- The program itself, with Start Menu and Desktop shortcuts. -->
    <Component Id="MainExe" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="PhotoDupeCheckerExe" Source="dist\PhotoDupeChecker\PhotoDupeChecker.exe" KeyPath="yes">
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Photo Duplicate Checker"
                  WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="AppIcon.ico" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Photo Duplicate Checker"
                  WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="AppIcon.ico" />
      </File>
    </Component>

    <!-- Everything else PyInstaller produced (libraries, DLLs, ...). -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="dist\PhotoDupeChecker\**">
        <Exclude Files="dist\PhotoDupeChecker\PhotoDupeChecker.exe" />
      </Files>
    </ComponentGroup>

    <Feature Id="Main" Title="Photo Duplicate Checker" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
